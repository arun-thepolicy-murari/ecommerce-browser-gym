# Gym runtime env — copy to `.env` (gitignored) and fill in.
# `.env` is read fresh on every agent run by server/main.py::_spawn_eval_run and
# OVERRIDES the process env, so you can drop in a fresh key without a restart.

# --- Anthropic (the `llm` browser agent = claude-sonnet-4-5-20250929) ---
# Put a NON-rate-limited key here to make agent="llm" drive forward.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
# Optional: override the llm browser agent's model.
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# --- OpenAI (the `openai` browser agent) — use this to run GPT-5.1 ---
# Run a task with agent="openai"; the model is read from OPENAI_MODEL below.
OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_MODEL=gpt-5.1
# If your GPT-5.1 access is via OpenRouter instead of the direct OpenAI API,
# uncomment these and set OPENAI_MODEL=openai/gpt-5.1 above:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# --- Rendering / debugging ---
# The platform runs the browser HEADLESS (no window pops up; you review the
# captured replay in the UI). Set GYM_HEADED=1 to watch the real browser locally.
# GYM_HEADED=1

# NOTE: HARNESS_TOKEN is read by the SERVER at startup (not per-run), so it must
# be in the gym server's launch environment, e.g.:
#   HARNESS_TOKEN=dev-annotator-token python -m uvicorn server.main:app --port 8000
# The annotator sends this exact token; keep them in sync.

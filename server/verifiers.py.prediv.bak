                      check=lambda p: (
                          p.state.current_user_id is not None
                          and any(
                              (a.label.lower() == "beach house" and a.is_default)
                              for a in p.state.users[p.state.current_user_id].addresses.values()
                          )
                      ),
                      required_for_success=True),
        ],
    )


